# Copy to .env. Never commit credentials. Local development uses Stripe test mode only.
DATABASE_URL=postgresql://gpu:gpu-local-only@localhost:5432/gpu_stock_watch
TEST_DATABASE_URL=postgresql://gpu:gpu-local-only@localhost:5432/gpu_stock_watch_test
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Exact approved US source only. See docs/retailer-sources.md before enabling.
BESTBUY_API_KEY=
BESTBUY_USAGE_APPROVED=false
BESTBUY_CHECK_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=1800
ALERT_TTL_SECONDS=900
WORKER_TICK_SECONDS=5

# Create a USD monthly recurring price in Stripe test mode ($7.99).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_PLAN_PRICE_CENTS=799
ENABLE_LIVE_CHECKOUT=false

# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Set only after exercising each real flow; these do not replace source freshness checks.
AUTH_FLOW_VERIFIED=false
EMAIL_DELIVERY_VERIFIED=false
PUSH_DELIVERY_VERIFIED=false
BILLING_FLOW_VERIFIED=false
HACKATHON_MODE=false
TRAFFIC_VERIFICATION_SCRIPT_URL=
TRAFFIC_VERIFICATION_VERIFIED=false
# Comma-separated verified account emails authorized for administrative exports.
ADMIN_EMAILS=

# Explicitly disables source requests, sign-in email, billing and customer alerts.
# No invented stock data is seeded, even in demo mode.
DEMO_MODE=false

