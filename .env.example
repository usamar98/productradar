# Copy to .env. Never commit credentials. Restock Radar accepts Stripe test keys only.
# Supabase: session-pooler or direct PostgreSQL connection, with TLS in production.
DATABASE_URL=postgresql://radar:replace-me@localhost:5432/restock_radar
TEST_DATABASE_URL=postgresql://radar:replace-me@localhost:5432/restock_radar_test
# Optional direct/session connection used for migrations; do not use a transaction pooler.
DIRECT_URL=
APP_URL=http://localhost:3000
# Generate each separately: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RADAR_AUTH_SECRET=
ADMIN_PASSWORD=
ALLOW_MOCK_CONNECTOR=false
# Development-only loopback email capture. Never enables real provider delivery.
RADAR_LOCAL_MAILBOX=false
# Requires a separate database whose name ends _local_test; see local test guide.
RADAR_LOCAL_TEST_MODE=false

# These shared email/push settings power the new Restock Radar flows below.
# Legacy GPU account configuration is retained for migration compatibility.
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Exact approved US source only. See docs/retailer-sources.md before enabling.
BESTBUY_API_KEY=
BESTBUY_USAGE_APPROVED=false
BESTBUY_CHECK_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=1800
ALERT_TTL_SECONDS=900
WORKER_TICK_SECONDS=5

# Restock Radar creates inline test prices from src/config/pricing.ts.
# STRIPE_PRICE_ID below is used only by the retained legacy GPU backend.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_SANDBOX_EXPIRES_AT=
NEXT_PUBLIC_PLAN_PRICE_CENTS=799
ENABLE_LIVE_CHECKOUT=false

# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Set only after exercising each real flow; these do not replace source freshness checks.
AUTH_FLOW_VERIFIED=false
EMAIL_DELIVERY_VERIFIED=false
PUSH_DELIVERY_VERIFIED=false
BILLING_FLOW_VERIFIED=false
HACKATHON_MODE=false
TRAFFIC_VERIFICATION_SCRIPT_URL=
TRAFFIC_VERIFICATION_VERIFIED=false
# Comma-separated verified account emails authorized for administrative exports.
ADMIN_EMAILS=

# Explicitly disables source requests, sign-in email, billing and customer alerts.
# No invented stock data is seeded, even in demo mode.
DEMO_MODE=false

