{
  "name": "restock-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "worker": "tsx worker/index.ts",
    "worker:once": "tsx worker/index.ts --once",
    "local-test:setup": "tsx scripts/local-test-setup.ts",
    "local-test": "node scripts/local-test-run.mjs",
    "test:alerts:local": "tsx scripts/test-restock-emails.ts",
    "stripe:listen": "node scripts/stripe-local.mjs",
    "stripe:listen:local-test": "node scripts/stripe-local.mjs --lab",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "sources:official": "tsx scripts/official-sources.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.25",
    "dotenv": "^17.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.0.0",
    "server-only": "^0.0.1",
    "stripe": "23.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
