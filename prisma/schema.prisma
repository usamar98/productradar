generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum InventoryState {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  BACKORDER
  UNKNOWN
  CHECK_FAILED
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  watch Watch?
  subscription Subscription?
  pushSubscriptions PushSubscription[]
  notifications NotificationJob[]
  payments Payment[]
  attributions Attribution[]
  checkoutAttempt CheckoutAttempt?
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}
model Watch {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailers String[] @default(["bestbuy"])
  maxPriceCents Int?
  emailEnabled Boolean @default(true)
  pushEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Subscription {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  status String @default("inactive")
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  refundedAt DateTime?
  lastEventCreated Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Retailer {
  id String @id
  name String
  sourceUrl String
  productIdentifier String
  enabled Boolean @default(false)
  intervalSeconds Int @default(300)
  lastAttemptAt DateTime?
  lastSuccessfulCheck DateTime?
  lastState InventoryState @default(UNKNOWN)
  lastPriceCents Int?
  lastError String?
  nextCheckAt DateTime @default(now())
  leaseUntil DateTime?
  observations InventoryObservation[]
  events StockEvent[]
}
model InventoryObservation {
  id String @id @default(cuid())
  retailerId String
  retailer Retailer @relation(fields: [retailerId], references: [id])
  productIdentifier String
  sourceUrl String
  state InventoryState
  priceCents Int?
  currency String @default("USD")
  checkedAt DateTime
  evidence Json
  shipping String?
  pickup String?
  events StockEvent[]
  @@index([retailerId, checkedAt])
  @@unique([retailerId, checkedAt])
}
model StockEvent {
  id String @id @default(cuid())
  retailerId String
  retailer Retailer @relation(fields: [retailerId], references: [id])
  observationId String @unique
  observation InventoryObservation @relation(fields: [observationId], references: [id])
  createdAt DateTime @default(now())
  jobs NotificationJob[]
  @@index([retailerId, createdAt])
}
model NotificationJob {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event StockEvent @relation(fields: [eventId], references: [id])
  channel String
  target String @default("email")
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  deliveredAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@unique([userId, eventId, channel, target])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}
model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
  @@index([userId])
}
model StripeEvent {
  id String @id
  type String
  createdAt DateTime @default(now())
}
model CheckoutAttempt {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? @unique
  expiresAt DateTime
  priceId String
  customerId String
  attributionId String?
  createdAt DateTime @default(now())
}
model Payment {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id])
  stripeCustomerId String
  stripePaymentIntentId String? @unique
  amountCents Int
  currency String @default("usd")
  status String
  refundedCents Int @default(0)
  paidAt DateTime
  attributionId String?
  attribution Attribution? @relation(fields: [attributionId], references: [id])
  refunds Refund[]
  @@index([userId])
}
model Refund {
  id String @id
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents Int
  currency String
  status String
  createdAt DateTime
  updatedAt DateTime @updatedAt
  @@index([paymentId])
}
model Attribution {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorId String?
  consentedAt DateTime
  utmSource String?
  utmMedium String?
  utmCampaign String?
  utmTerm String?
  utmContent String?
  referringDomain String?
  landingPage String
  createdAt DateTime @default(now())
  payments Payment[]
  @@index([userId])
}
model MarketingExpense {
  id String @id @default(cuid())
  date DateTime
  amountCents Int
  currency String @default("usd")
  channel String
  description String
}

// Generic Restock Radar catalog and delivery engine. Existing data is preserved.
model RadarCategory {
  id String @id @default(cuid())
  slug String @unique
  name String
  items RadarItem[]
  @@map("categories")
}
model RadarItem {
  id String @id @default(cuid())
  categoryId String
  category RadarCategory @relation(fields: [categoryId], references: [id])
  slug String @unique
  name String
  msrpCents Int?
  imageUrl String?
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  variants RadarVariant[]
  sources RadarSource[]
  alerts RadarAlert[]
  @@map("items")
}
model RadarVariant {
  id String @id @default(cuid())
  itemId String
  item RadarItem @relation(fields: [itemId], references: [id])
  slug String
  label String
  sources RadarSource[]
  alerts RadarAlert[]
  @@unique([itemId, slug])
  @@map("variants")
}
model RadarSource {
  id String @id @default(cuid())
  itemId String
  item RadarItem @relation(fields: [itemId], references: [id])
  variantId String
  variant RadarVariant @relation(fields: [variantId], references: [id])
  retailer String
  label String
  // A store ID is meaningful only for pickup; online availability is separate.
  locationId String?
  fulfillment String @default("online")
  productUrl String
  connector String @default("jsonld")
  pollSeconds Int @default(15)
  status String @default("paused")
  approved Boolean @default(false)
  inStock Boolean?
  priceCents Int?
  lastCheckedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  nextCheckAt DateTime @default(now())
  leaseUntil DateTime?
  failureCount Int @default(0)
  events RadarStockEvent[]
  @@unique([variantId, retailer])
  @@index([status, nextCheckAt])
  @@map("sources")
  @@index([locationId, variantId])
}
model RadarStockEvent {
  id String @id @default(cuid())
  sourceId String
  source RadarSource @relation(fields: [sourceId], references: [id])
  inStock Boolean @default(true)
  priceCents Int?
  seenAt DateTime @default(now())
  endedAt DateTime?
  notifications RadarNotification[]
  @@index([sourceId, seenAt])
  @@map("stock_events")
}
model RadarUser {
  id String @id @default(cuid())
  email String @unique
  tokenHash String? @unique
  createdAt DateTime @default(now())
  pushSubscriptions RadarPushSubscription[]
  subscriptions RadarSubscription[]
  alerts RadarAlert[]
  payments RadarPayment[]
  @@map("users")
}
model RadarPushSubscription {
  id String @id @default(cuid())
  userId String
  user RadarUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  keys Json
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("push_subscriptions")
}
model RadarPlan {
  id String @id
  name String
  priceCents Int
  alertLimit Int
  type String
  subscriptions RadarSubscription[]
  alerts RadarAlert[]
  @@map("plans")
}
model RadarSubscription {
  id String @id @default(cuid())
  userId String
  user RadarUser @relation(fields: [userId], references: [id])
  planId String
  priceCents Int?
  alertLimit Int?
  plan RadarPlan @relation(fields: [planId], references: [id])
  providerRef String @unique
  customerRef String?
  status String @default("pending")
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt DateTime?
  lastEventCreated Int @default(0)
  createdAt DateTime @default(now())
  alerts RadarAlert[]
  @@index([userId])
  @@map("subscriptions")
}
model RadarAlert {
  id String @id @default(cuid())
  userId String
  user RadarUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId String
  item RadarItem @relation(fields: [itemId], references: [id])
  variantId String
  variant RadarVariant @relation(fields: [variantId], references: [id])
  planId String
  plan RadarPlan @relation(fields: [planId], references: [id])
  subscriptionId String?
  subscription RadarSubscription? @relation(fields: [subscriptionId], references: [id])
  sourceIds String[]
  status String @default("pending")
  activeUntil DateTime?
  caughtAt DateTime?
  tokenHash String?
  checkoutRef String? @unique
  createdAt DateTime @default(now())
  notifications RadarNotification[]
  @@index([userId, status])
  @@index([itemId, variantId, status])
  @@map("alerts")
}
model RadarNotification {
  id String @id @default(cuid())
  alertId String
  alert RadarAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  stockEventId String
  stockEvent RadarStockEvent @relation(fields: [stockEventId], references: [id])
  channel String
  target String @default("email")
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  sentAt DateTime?
  latencyMs Int?
  lastError String?
  createdAt DateTime @default(now())
  @@unique([alertId, stockEventId, channel, target])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}
model RadarPayment {
  id String @id @default(cuid())
  userId String
  user RadarUser @relation(fields: [userId], references: [id])
  amountCents Int
  feeCents Int @default(0)
  feeRecorded Boolean @default(false)
  refundedCents Int @default(0)
  refundedAt DateTime?
  subscriptionId String?
  periodEnd DateTime?
  refunds RadarRefund[]
  providerRef String @unique
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("payments")
}
model RadarRefund {
  id String @id
  paymentId String
  payment RadarPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents Int
  status String
  createdAt DateTime
  @@index([createdAt])
  @@map("refunds")
}
model RadarCost {
  id String @id @default(cuid())
  label String
  amountCents Int
  category String
  incurredAt DateTime @default(now())
  @@map("costs")
}
model RadarCustomerPost {
  id String @id @default(cuid())
  url String
  text String
  createdAt DateTime @default(now())
  @@map("customer_posts")
}
model RadarWebhookEvent {
  id String @id
  type String
  createdAt DateTime @default(now())
  @@map("webhook_events")
}

model RadarFeedSync {
  id String @id
  blocked Boolean @default(false)
  nextCheckAt DateTime @default(now())
  leaseUntil DateTime?
  revision String?
  message String?
  @@map("inventory_feed_sync")
}
